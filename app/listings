import { supabase } from '@/lib/supabaseClient';

export default async function ListingsPage() {
  const { data: listings } = await supabase
    .from('listings')
    .select('*')
    .order('id', { ascending: false })
    .limit(20);

  return (
    <main>
      <h1 style={{ fontWeight: 600, fontSize: 20, marginBottom: 12 }}>Listing Terbaru</h1>
      <ul style={{ display: 'grid', gap: 12, gridTemplateColumns: 'repeat(auto-fill,minmax(220px,1fr))' }}>
        {listings?.map((l) => (
          <li key={l.id} style={{ border: '1px solid #ccc', padding: 10 }}>
            <a href={/listings/${l.id}} style={{ textDecoration: 'none' }}>
              <h2 style={{ fontWeight: 600 }}>{l.title}</h2>
              <p>{l.brand} - {l.year}</p>
              <p>Rp {l.price}</p>
            </a>
          </li>
        ))}
      </ul>
    </main>
  );
}
